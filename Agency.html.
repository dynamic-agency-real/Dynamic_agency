                <h3 class="text-2xl font-bold mb-4">1,000 Likes</h3>
                <div class="text-3xl font-bold mb-6">₹30 <span class="text-lg text-gray-500">/ $0.36</span></div>
                
                <div class="space-y-3 mb-6">
                    <a href="upi://pay?pa=9540775314@yesfam&am=30&cu=INR&pn=DynamicsAgency" class="w-full block text-center bg-green-600 py-2 rounded-lg font-bold"><i class="fas fa-mobile-alt mr-2"></i>Pay via UPI</a>
                    <a href="https://www.binance.com/en/my/wallet/account/payment/send?payId=1023765618" class="w-full block text-center bg-yellow-500 text-black py-2 rounded-lg font-bold"><i class="fab fa-bitcoin mr-2"></i>Pay via Binance</a>
                </div>

                <form onsubmit="submitOrder(event, '1k Likes', '₹30')" class="pt-4 border-t border-gray-700">
