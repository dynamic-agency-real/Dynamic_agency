        <button id="loginBtn" onclick="login()" class="bg-blue-600 hover:bg-blue-700 px-5 py-2 rounded-full font-medium transition">
            <i class="fab fa-google mr-2"></i>Login with Google
        </button>
    </nav>

    <main class="container mx-auto px-4 py-12">
