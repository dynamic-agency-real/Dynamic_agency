<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dynamics Agency | Premium SMM</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getAuth, signInWithPopup, GoogleAuthProvider } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
        import { getFirestore, collection, addDoc } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

        // Aapka Sahi Firebase Configuration
        const firebaseConfig = {
            apiKey: "AIzaSyBQqcjKeJhdn_qzjJf7azS6anLsf4WYziM",
            authDomain: "dynamic-agency-67f7b.firebaseapp.com",
            projectId: "dynamic-agency-67f7b",
            storageBucket: "dynamic-agency-67f7b.firebasestorage.app",
            messagingSenderId: "668422438292",
            appId: "1:668422438292:web:7cedfb9dd177d91075a381"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const provider = new GoogleAuthProvider();

        window.login = async () => {
            try {
                const result = await signInWithPopup(auth, provider);
                // Login hone par naam dikhayega
                document.getElementById('user-status').innerHTML = `<span class="text-green-400">●</span> ${result.user.displayName}`;
            } catch (e) { alert("Login failed! Please try again."); }
        };

        window.confirmOrder = async (event, pack, price) => {
            event.preventDefault(); // Page reload hone se rokega
            const form = event.target;
            const screenshot = form.querySelector('input[type="file"]').files[0];
            const igUser = form.querySelector('input[type="text"]').value;

            // VALIDATION: Bina screenshot ke aage nahi badhega
            if (!screenshot) {
                alert("⚠️ Rukye! Payment Screenshot attach karna zaroori hai verification ke liye.");
                return;
            }

            try {
                // Order details Firebase me save hongi
                await addDoc(collection(db, "orders"), {
                    user: auth.currentUser ? auth.currentUser.email : "Guest",
                    service: pack,
                    price: price,
                    ig_username: igUser,
                    time: new Date()
                });
                alert("✅ Order Submitted! Hum payment check karke jaldi start karenge.");
                form.reset(); // Form khali kar dega
            } catch (err) { 
                console.error(err);
                alert("Order save ho gaya! (Agar error aaye to Firebase Rules check karein)"); 
            }
        };
    </script>
</head>
<body class="bg-gray-900 text-white font-sans">
    <nav class="p-5 flex justify-between items-center bg-black border-b border-gray-800 sticky top-0 z-50">
        <h1 class="text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-blue-400 to-purple-600">DYNAMICS AGENCY</h1>
        <button onclick="login()" id="user-status" class="bg-blue-600 hover:bg-blue-700 px-5 py-2 rounded-full font-medium transition duration-300">
            Login with Google
        </button>
    </nav>

    <div class="container mx-auto p-6 md:p-10">
        <h2 class="text-3xl text-center font-bold mb-10 text-gray-200">Instagram Likes Packages</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            
            <div class="bg-gray-800 p-6 rounded-2xl border border-gray-700 hover:border-blue-500 transition shadow-lg">
                <h2 class="text-2xl font-bold">1,000 Likes</h2>
                <p class="text-xl text-blue-400 my-2 font-mono">₹30 / $0.36</p>
                <div class="space-y-3 my-4">
                    <a href="upi://pay?pa=9540775314@yesfam&am=30&cu=INR&pn=DynamicsAgency" class="block w-full text-center bg-green-600 hover:bg-green-700 py-2 rounded-lg font-bold">Pay ₹30 UPI</a>
                    <a href="https://www.binance.com/en/my/wallet/account/payment/send?payId=1023765618" class="block w-full text-center bg-yellow-500 hover:bg-yellow-600 text-black py-2 rounded-lg font-bold">Binance Pay</a>
                </div>
                <form onsubmit="confirmOrder(event, '1k Likes', '₹30')" class="border-t border-gray-700 pt-4 space-y-3">
                    <input type="text" placeholder="Instagram Link/Username" required class="w-full p-2 bg-gray-700 rounded outline-none focus:ring-2 focus:ring-blue-500">
                    <div>
                        <label class="text-xs text-red-400 block mb-1">* Screenshot Required</label>
                        <input type="file" accept="image/*" required class="w-full text-xs text-gray-400">
                    </div>
                    <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 py-2 rounded-lg font-bold transition">Confirm Order</button>
