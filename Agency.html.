<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dynamics Agency | Premium SMM Services</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"></script>
    
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getAuth, signInWithPopup, GoogleAuthProvider } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
        import { getFirestore, collection, addDoc } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyBQqcjKeJhdn_qzjJf7azS6anLsf4WYziM",
            authDomain: "dynamic-agency-67f7b.firebaseapp.com",
            projectId: "dynamic-agency-67f7b",
            storageBucket: "dynamic-agency-67f7b.firebasestorage.app",
            messagingSenderId: "668422438292",
            appId: "1:668422438292:web:7cedfb9dd177d91075a381"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const provider = new GoogleAuthProvider();

        window.login = async () => {
            try {
                const result = await signInWithPopup(auth, provider);
                document.getElementById('loginBtn').innerHTML = `<img src="${result.user.photoURL}" class="w-8 h-8 rounded-full inline mr-2"> ${result.user.displayName}`;
            } catch (error) { alert("Login Failed!"); }
        };

        window.submitOrder = async (event, packName, price) => {
            event.preventDefault();
            const form = event.target;
            const screenshot = form.querySelector('input[type="file"]').files[0];
            const username = form.querySelector('input[type="text"]').value;

            if (!screenshot) {
                alert("Error: Payment Screenshot attached karna zaroori hai! [Verification Required]");
                return;
            }

            try {
                await addDoc(collection(db, "orders"), {
                    user: auth.currentUser ? auth.currentUser.email : "Guest",
                    service: packName,
                    amount: price,
                    ig_username: username,
                    timestamp: new Date()
                });
                alert("Order Placed Successfully! Verification pending.");
            } catch (e) { alert("Error submitting order."); }
        };
    </script>

    <style>
        #loader { position: fixed; width: 100%; height: 100vh; background: #000; display: flex; justify-content: center; align-items: center; z-index: 9999; }
        .pricing-card { background: rgba(31, 41, 55, 1); border: 1px solid #374151; transition: 0.3s; }
        .pricing-card:hover { border-color: #3b82f6; transform: translateY(-5px); }
    </style>
</head>
<body class="bg-gray-900 text-white font-sans">

    <div id="loader">
