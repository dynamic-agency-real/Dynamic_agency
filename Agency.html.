                    <label class="text-xs text-gray-400 block mb-1 text-red-400 font-bold">* Required: Payment Screenshot</label>
                    <input type="file" accept="image/*" required class="w-full text-xs mb-4">
                    <button type="submit" class="w-full bg-blue-600 py-2 rounded-lg font-bold hover:bg-blue-500 transition">Confirm Order</button>
                </form>
            </div>

            <div class="pricing-card p-6 rounded-2xl">
                <div class="text-blue-500 text-sm font-bold uppercase mb-2">Popular</div>
                <h3 class="text-2xl font-bold mb-4">4,000 Likes</h3>
                <div class="text-3xl font-bold mb-6">₹115 <span class="text-lg text-gray-500">/ $1.38</span></div>
                <div class="space-y-3 mb-6">
                    <a href="upi://pay?pa=9540775314@yesfam&am=115&cu=INR&pn=DynamicsAgency" class="w-full block text-center bg-green-600 py-2 rounded-lg font-bold">Pay via UPI</a>
                    <a href="https://www.binance.com/en/my/wallet/account/payment/send?payId=1023765618" class="w-full block text-center bg-yellow-500 text-black py-2 rounded-lg font-bold">Pay via Binance</a>
                </div>
                <form onsubmit="submitOrder(event, '4k Likes', '₹115')" class="pt-4 border-t border-gray-700">
                    <input type="text" placeholder="IG Username/Link" required class="w-full bg-gray-700 p-2 rounded mb-3">
                    <input type="file" accept="image/*" required class="w-full text-xs mb-4">
                    <button type="submit" class="w-full bg-blue-600 py-2 rounded-lg font-bold">Confirm Order</button>
                </form>
            </div>

            <div class="pricing-card p-6 rounded-2xl scale-105 border-blue-500">
                <div class="bg-blue-500 text-white text-[10px] px-2 py-1 rounded absolute -top-3 left-1/2 -translate-x-1/2 font-bold uppercase">Best Value</div>
                <h3 class="text-2xl font-bold mb-4">10,000 Likes</h3>
                <div class="text-3xl font-bold mb-6">₹280 <span class="text-lg text-gray-500">/ $3.36</span></div>
                <div class="space-y-3 mb-6">
                    <a href="upi://pay?pa=9540775314@yesfam&am=280&cu=INR&pn=DynamicsAgency" class="w-full block text-center bg-green-600 py-2 rounded-lg font-bold">Pay via UPI</a>
                    <a href="https://www.binance.com/en/my/wallet/account/payment/send?payId=1023765618" class="w-full block text-center bg-yellow-500 text-black py-2 rounded-lg font-bold">Pay via Binance</a>
                </div>
                <form onsubmit="submitOrder(event, '10k Likes', '₹280')" class="pt-4 border-t border-gray-700">
                    <input type="text" placeholder="IG Username/Link" required class="w-full bg-gray-700 p-2 rounded mb-3">
                    <input type="file" accept="image/*" required class="w-full text-xs mb-4">
                    <button type="submit" class="w-full bg-blue-600 py-2 rounded-lg font-bold">Confirm Order</button>
                </form>
            </div>

            <div class="pricing-card p-6 rounded-2xl">
                <div class="text-blue-500 text-sm font-bold uppercase mb-2">Agency Pack</div>
                <h3 class="text-2xl font-bold mb-4">20,000 Likes</h3>
                <div class="text-3xl font-bold mb-6">₹570 <span class="text-lg text-gray-500">/ $6.84</span></div>
                <div class="space-y-3 mb-6">
                    <a href="upi://pay?pa=9540775314@yesfam&am=570&cu=INR&pn=DynamicsAgency" class="w-full block text-center bg-green-600 py-2 rounded-lg font-bold">Pay via UPI</a>
                    <a href="https://www.binance.com/en/my/wallet/account/payment/send?payId=1023765618" class="w-full block text-center bg-yellow-500 text-black py-2 rounded-lg font-bold">Pay via Binance</a>
                </div>
                <form onsubmit="submitOrder(event, '20k Likes', '₹570')" class="pt-4 border-t border-gray-700">
                    <input type="text" placeholder="IG Username/Link" required class="w-full bg-gray-700 p-2 rounded mb-3">
                    <input type="file" accept="image/*" required class="w-full text-xs mb-4">
                    <button type="submit" class="w-full bg-blue-600 py-2 rounded-lg font-bold">Confirm Order</button>
                </form>
            </div>

        </div>
    </main>

    <footer class="text-center p-10 text-gray-500 text-sm">
        &copy; 2026 Dynamics Agency. All payments verified via Screenshot validation.
    </footer>

    <script>
        setTimeout(() => {
            document.getElementById('loader').style.opacity = '0';
            setTimeout(() => { document.getElementById('loader').style.display = 'none'; }, 500);
        }, 4000);
    </script>
</body>
</html>
